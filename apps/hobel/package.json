{
  "name": "hobel",
  "version": "0.1.0",
  "private": true,
  "description": "Learning rebuild of a desktop Java IDE's core loop (clean room).",
  "main": "out/main/index.js",
  "license": "MIT",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "jdtls:download": "node scripts/download-jdtls.mjs",
    "test:e2e": "npm run build && node --test --test-concurrency=1 tests/e2e/*.test.mjs",
    "test:unit": "node scripts/build-tests.mjs && node --test out/unit/*.test.js",
    "test": "npm run typecheck && npm run test:unit",
    "seed": "node scripts/seed.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "axe-core": "^4.14.0",
    "electron": "^45.2.1",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "lucide-react": "^1.67.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vscode-jsonrpc": "^10.0.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  },
  "productName": "Hobel"
}
