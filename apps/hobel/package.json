{
  "name": "hobel",
  "version": "0.1.0",
  "private": true,
  "description": "Learning rebuild of a desktop Java IDE's core loop (clean room).",
  "main": "out/main/index.js",
  "license": "MIT",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "jdtls:download": "node scripts/download-jdtls.mjs",
    "test:e2e": "npm run build && node --test --test-concurrency=1 tests/e2e/*.test.mjs",
    "test:unit": "node scripts/build-tests.mjs && node --test out/unit/*.test.js",
    "test": "npm run typecheck && npm run test:unit",
    "seed": "node scripts/seed.mjs",
    "dist": "npm run build && electron-builder --publish never"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "axe-core": "^4.14.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.67.0",
    "monaco-editor": "^0.57.0",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vscode-jsonrpc": "^10.0.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  },
  "productName": "Hobel",
  "build": {
    "appId": "org.symfonapps.hobel",
    "productName": "Hobel",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".jdtls/server",
        "to": "jdtls",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "publish": null
  }
}
