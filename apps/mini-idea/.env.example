# Mini-IDEA has no server, no accounts and no API keys. These variables only
# change where it keeps data and which tools it uses. All are optional.

# Where state.db and logs live (default: the OS app-data folder for Mini-IDEA).
MINI_IDEA_USER_DATA=

# Path to an unpacked Eclipse JDT Language Server (default: ./.jdtls/server).
MINI_IDEA_JDTLS=

# Download URL for `npm run jdtls:download` (default: pinned 1.61.0, works with Java 21).
JDTLS_URL=

# JDK used for the language server, javac and java (default: the one on PATH).
JAVA_HOME=

# Tests only: folder returned by the "Open folder" dialog without showing it.
MINI_IDEA_PICK_FOLDER=
